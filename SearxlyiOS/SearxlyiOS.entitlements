<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared container for the Home Screen widgets: SharedPrivacyStats mirrors the lifetime
	     trackers-blocked count here so the widget target (SearxlyWidgets) can read it. Must match
	     SharedPrivacyStats.appGroup and the widget target's own entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.myrhex.searxly</string>
	</array>
</dict>
</plist>
