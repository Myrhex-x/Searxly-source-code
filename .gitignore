# ─────────────────────────────────────────────────────────────────────────────
# Searxly — public repository .gitignore
#
# This repo publishes source for transparency/review only. Several things are
# deliberately kept OUT of the public tree:
#   • Build outputs and any distributable app/dmg (so no binary can be downloaded)
#   • The app entry point (so a fresh clone does not build a runnable app)
#   • The ad-block engine and the VPN/WireGuard implementation (kept private)
#   • Signing identity, local machine state, and secrets
# Ignored files still live in the maintainer's local working copy — git just
# never tracks or publishes them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Build artifacts / distributables (no downloadable binary in the repo) ──────
build/
dist/
DerivedData/
*.xcarchive
*.app
*.dmg
*.ipa

# ── Swift Package Manager ──────────────────────────────────────────────────────
.build/
**/.build/
.swiftpm/
Package.resolved

# ── Xcode user-specific state ──────────────────────────────────────────────────
**/xcuserdata/
*.xcuserstate
*.xcuserdatad

# ── macOS noise ────────────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store

# ── Local tooling / agent state (contains absolute machine paths) ──────────────
.claude/settings.local.json

# ── Secrets / generated config ─────────────────────────────────────────────────
# Real SearXNG config is generated at runtime; only the *.example template ships.
**/settings.yml
!**/settings.yml.example
searxng-local/
*.log
*.env
.env*

# ─────────────────────────────────────────────────────────────────────────────
# Intentionally PRIVATE source (implementation hidden from the public repo)
# ─────────────────────────────────────────────────────────────────────────────

# App entry point — omitted so public clones can't build a runnable/distributable app
Searxly/App/SearxlyApp.swift

# Operator-side cloud AI config — contains the io.net API key; never publish
Searxly/LocalAI/Core/SearxlyAICloud.swift

# Ad-block engine — implementation, filter lists, and cosmetic configs kept private
Searxly/AdBlocker/
Searxly/Browser/WebViewRepresentable+AdBlock.swift
scripts/regenerate_ublock_filters.py

# VPN / WireGuard — adapter, tunnel provider, and UI kept private
Searxly/VPN/
SearxlyWireGuardTunnel/
Searxly/Views/Features/VPNOwnServersView.swift
Searxly/Views/Features/VPNManagedView.swift
Searxly/Views/Features/VPNMaximumView.swift
Searxly/Views/Features/CardCheckoutSheet.swift
Searxly/Views/Components/VPNBrowserControl.swift
Searxly/Views/Components/SearxlyVPNPill.swift
# Operator-side VPN control plane (BitLaunch exit node + USDC payment verification) — kept private
vpn-control-plane/

# Real-celebrity photos + generators — publicity/copyright; kept private
Searxly/Resources/CelebrityFaces/
scripts/regenerate_celebrity_faces.py
scripts/add_celebrity_face.sh

# Third-party NSFW domain blocklist — kept private (attribution/redistribution)
SearxlyShared/ContentSafety/

# ── Secrets & signing material (never commit) ──────────────────────────────────
# The Searxly gateway app token is supplied per-build via the SEARXLY_GATEWAY_APP_TOKEN
# env var or a gitignored xcconfig — the compiled-in fallback in SearxlyGateway.swift is blank.
Secrets.xcconfig
*.secret.xcconfig
*.secrets.xcconfig
# Gateway deploy config (Caddyfile, systemd unit, deploy guide) lives in a private ops repo,
# not the public source. Kept locally for deployment, never tracked.
gateway/
# Apple signing / provisioning material
*.p12
*.cer
*.pem
*.mobileprovision
*.provisionprofile

# Maintainer-only working docs. Trademark filing puts the applicant's name and address on a public
# register, so the prep notes discuss the owner's identity directly — kept out of the public tree.
Trademark-Prep.md

# Local editor tooling + Xcode caches (not part of the source)
.claude/
27.0-27A5194q/

# ── iOS port of the private ad-block engine (same policy as Searxly/AdBlocker/) ──
SearxlyiOS/Shields/AdBlock/

# ─────────────────────────────────────────────────────────────────────────────
# Searxly Maximum — the paid edition. Its source lives in its own repository.
#
# Maximum is not a separate codebase: it's this source built as a second target
# with MAXIMUM_EDITION defined, so `Edition.isMaximum` branches remain in shared
# files here. What's excluded is everything that only Maximum has — the licence
# system and the edition's own UI and hardening.
# ─────────────────────────────────────────────────────────────────────────────
Searxly/App/Licensing.swift
Searxly/App/MachineID.swift
Searxly/Views/Features/MaximumActivationView.swift
Searxly/Views/Features/Settings/MaximumStatusBoard.swift
Searxly/Views/Components/MaximumEditionBadge.swift
Searxly/Privacy/MaximumSecurityLevel.swift
Searxly/Privacy/MAXIMUM-HARDENING.md
SearxlyTests/LicensingTests.swift
Searxly/SearxlyMaximum.entitlements
Searxly/Assets.xcassets/AppIconMaximum.appiconset/
Searxly.xcodeproj/xcshareddata/xcschemes/SearxlyMaximum.xcscheme
