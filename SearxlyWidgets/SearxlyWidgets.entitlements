<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same container as the app's own entitlements. The widget runs in its own process and can
	     only see the lifetime trackers-blocked count through this shared group — see
	     SharedPrivacyStats, which both targets compile from SearxlyWidgetShared/. If the group id
	     here and in SearxlyiOS.entitlements ever drift, the widget silently reads 0. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.myrhex.searxly</string>
	</array>
</dict>
</plist>
