<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Only the keys the auto-generated Info.plist can't express live here (it still supplies
	  everything from the INFOPLIST_KEY_* build settings). This registers the searxly:// scheme
	  so Home Screen widgets and the Share extension can deep-link into the app.
	-->
	<!-- Lets web audio and video keep playing after the app leaves the foreground or the screen
	     locks, and keeps a Picture-in-Picture video alive. The capability has to be declared
	     statically, but it is only ever exercised when the user turns on Settings ▸ Privacy ▸
	     Background Media (default OFF) or puts a video into Picture in Picture — see
	     MediaPlayback.swift and TabsModel.backgroundMediaExemption. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.myrhex.SearxlyiOS</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>searxly</string>
			</array>
		</dict>
		<!-- Required by Apple's default-browser entitlement review: an app asking to be selectable
		     under Settings ▸ Apps ▸ Default Apps ▸ Browser must declare that it handles http and
		     https. BrowserView.handleDeepLink already opens either scheme straight into a new tab;
		     this only states it. Declaring the schemes changes nothing on its own — iOS keeps
		     routing web links to the current default until the entitlement is granted. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLName</key>
			<string>com.myrhex.SearxlyiOS.web</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
	</array>
	<!-- Encrypted sync bundles (Settings ▸ Sync). Declaring the UTI + document type makes
	     AirDropped .searxlysync files offer "Open in Searxly"; SyncFile.type references the
	     same identifier. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.searxly.sync</string>
			<key>UTTypeDescription</key>
			<string>Searxly Sync Bundle</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>searxlysync</string>
				</array>
			</dict>
		</dict>
	</array>
	<!-- Declaring a document type obliges this key (ASC warns otherwise). NO = incoming
	     .searxlysync files are handed to the app as copies, which is exactly the receive flow
	     (handleDeepLink reads the bytes once; nothing is edited in place). -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Searxly Sync Bundle</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.searxly.sync</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
