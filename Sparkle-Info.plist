<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>SUPublicEDKey</key>
	<string>Ux3FWPU98QvA5heMYRYMd+yREYF+tgWSyAczgXFbH1w=</string>
	<key>SUFeedURL</key>
	<string>https://searxly.app/appcast.xml</string>

	<!-- Searxly Maximum is a SEPARATE product with its own signed release channel. It must NEVER pull the
	     base appcast above — installing that would replace Maximum with the base Searxly app. Maximum's
	     feed lives in these keys and is read ONLY by Maximum builds. They are intentionally BLANK until
	     the Maximum channel is published, so Maximum does not auto-update yet. To turn it on later, set
	     SUFeedURLMaximum (and optionally a .onion mirror) — no code change required. -->
	<key>SUFeedURLMaximum</key>
	<string></string>
	<key>SUFeedURLMaximumOnion</key>
	<string></string>

	<key>SUEnableInstallerLauncherService</key>
	<true/>

	<!-- Searxly gateway app token. Substituted at build time from SEARXLY_GATEWAY_APP_TOKEN
	     (blank default in Config.xcconfig; real value layered in via the gitignored Secrets.xcconfig).
	     A soft gate only — the upstream 0x / io.net keys live on the gateway server, never here.
	     When blank the wallet falls back to its "bring your own 0x key" path. -->
	<key>SearxlyGatewayAppToken</key>
	<string>$(SEARXLY_GATEWAY_APP_TOKEN)</string>

	<!-- Discord webhook for in-app feedback (Settings → Feedback + knowledge-panel contributions).
	     Substituted at build time from SEARXLY_FEEDBACK_WEBHOOK (blank in the public source; real
	     value in the gitignored Secrets.xcconfig, stored WITHOUT the https:// scheme — xcconfig
	     treats "//" in values as a comment. FeedbackWebhook.swift adds the scheme). -->
	<key>SearxlyFeedbackWebhook</key>
	<string>$(SEARXLY_FEEDBACK_WEBHOOK)</string>
	<key>SearxlyKnowledgeWebhook</key>
	<string>$(SEARXLY_KNOWLEDGE_WEBHOOK)</string>

	<!--
		App Transport Security — Tor .onion exception (scoped, NOT a blanket http allowance).
		Cleartext http is allowed ONLY for *.onion hidden services — http is the onion convention, and
		Tor itself encrypts + authenticates end-to-end via the .onion address. ATS stays fully enforced
		everywhere else: insecure http to clearnet sites is still blocked (HTTPS-only for the normal web),
		as are the app's own non-web connections (SearXNG API, gateway, Sparkle updates).
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>onion</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!--
		Web browser registration. Declaring http/https handling is what makes macOS list Searxly under
		System Settings → Desktop & Dock → Default web browser, so it can actually be set as the user's
		default and receive links opened from other apps (Mail, Messages, Slack, …). Without this the
		app can never replace Safari/Chrome as the daily driver. Pairs with DefaultBrowserManager, which
		asks the OS to make Searxly the default.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Web site URL</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>http</string>
				<string>https</string>
			</array>
		</dict>
	</array>

	<!--
		Local document handling. Declaring these standard web UTIs is what makes macOS list Searxly under
		a local file's "Open With" menu, lets it be set as the default handler for .html, and delivers a
		double-clicked / dragged-onto-the-Dock file to the app (via SwiftUI's .onOpenURL → openExternalURL
		→ openLocalFileURL). Role = Viewer (a browser displays these); LSHandlerRank = Alternate so Searxly
		is offered alongside the system default rather than seizing it. Reading the opened file is covered
		by the user-selected-files sandbox entitlement (the Open/double-click grant).
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>HTML document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.html</string>
				<string>public.xhtml</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Web document</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.svg-image</string>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
